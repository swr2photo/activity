rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data;
    }

    // ใช้ Custom Claims ก่อน (0 Firestore reads!) และ fallback ไป adminUsers/{uid} สำหรับเซสชันเก่า
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.isActive == true && request.auth.token.role != null) ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
         getAdminData().isActive == true)
      );
    }

    function getStudentData() {
      return get(/databases/$(database)/documents/universityUsers/$(request.auth.uid)).data;
    }

    function isActivityOpen(activityDocId) {
      let activity = get(/databases/$(database)/documents/activityQRCodes/$(activityDocId)).data;
      return activity.get('isActive', true) != false &&
        (activity.get('maxParticipants', 0) == 0 ||
         activity.get('currentParticipants', 0) < activity.get('maxParticipants', 0));
    }

    // 1. adminUsers — ปิดช่องโหว่ self-promote (การรับคำเชิญทำผ่าน /api/invites/claim ด้วย Admin SDK)
    match /adminUsers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // legacy collection — ปิดการเข้าถึงจาก client
    match /admins/{uid} {
      allow read, write: if false;
    }

    // 2. adminInvites — ปิดไม่ให้ผู้ใช้ทั่วไปอ่าน token คำเชิญได้
    match /adminInvites/{inviteId} {
      allow read, write: if isAdmin();
    }

    // 3. activities & activityQRCodes (PRIMARY_ACTIVITY_COLLECTION)
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /activityQRCodes/{qrId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // วางเงื่อนไขนักศึกษาก่อน isAdmin() เพื่อลดการอ่าน adminUsers/{uid}
      allow update: if (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentParticipants']) &&
        request.resource.data.currentParticipants == resource.data.get('currentParticipants', 0) + 1
      ) || isAdmin();

      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }
    }

    // 4. activityRecords — วาง Ownership check ก่อน isAdmin() เพื่อลด +1-4 reads/request
    match /activityRecords/{recordId} {
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/universityUsers/$(request.auth.uid)) &&
         string(resource.data.studentId) == string(getStudentData().studentId)) ||
        isAdmin()
      );
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/universityUsers/$(request.auth.uid)) &&
         resource.data.studentId == getStudentData().studentId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid &&
         exists(/databases/$(database)/documents/universityUsers/$(request.auth.uid)) &&
         getStudentData().get('isActive', true) != false &&
         string(request.resource.data.studentId) == string(getStudentData().studentId) &&
         isActivityOpen(request.resource.data.activityDocId)) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.studentId == resource.data.studentId &&
         request.resource.data.activityCode == resource.data.activityCode &&
         request.resource.data.activityDocId == resource.data.activityDocId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 5. universityUsers — วาง request.auth.uid == uid ก่อน isAdmin()
    match /universityUsers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && (
        (request.auth.uid == uid &&
         request.resource.data.get('isActive', true) == true) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (request.auth.uid == uid &&
         request.resource.data.get('isActive', true) == resource.data.get('isActive', true) &&
         request.resource.data.get('isVerified', true) == resource.data.get('isVerified', true)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 6. logs (System logs)
    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 7. ipLoginRecords — ปิดไม่ให้สาธารณะอ่านอีเมล/IP หรือเขียนขยะ (ไม่ใช้บล็อก IP แล้ว)
    match /ipLoginRecords/{recordId} {
      allow read, write: if isAdmin();
    }

    // 8. errorReports (Frontend errors — จำกัดขนาด payload)
    match /errorReports/{reportId} {
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    // 9. departments
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. systemSettings
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. customShortLinks
    match /customShortLinks/{linkId} {
      allow read, write: if isAdmin();
    }

    // 12. shortLinkVisits
    match /shortLinkVisits/{visitId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 13. surveyResponses — วางเจ้าของก่อน isAdmin()
    match /surveyResponses/{responseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 14. users (compat mirror — วางเจ้าของก่อน isAdmin())
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && (
        (request.auth.uid == uid &&
         request.resource.data.get('isActive', true) == true) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        (request.auth.uid == uid &&
         request.resource.data.get('isActive', true) == resource.data.get('isActive', true) &&
         request.resource.data.get('isVerified', true) == resource.data.get('isVerified', true)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 15. adminSettings
    match /adminSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 16. loginSessions — วางเจ้าของก่อน isAdmin()
    match /loginSessions/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    // 17. activityClaims — เจ้าของเดิมหรือสร้างใหม่เท่านั้น
    match /activityClaims/{claimId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 18. adminNotifications
    match /adminNotifications/{notifId} {
      allow read, write: if isAdmin();
    }
  }
}
